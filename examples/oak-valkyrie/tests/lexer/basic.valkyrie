# Valkyrie Language Comprehensive Lexer Test
# Valkyrie is a Rust-like language with unique syntax features

# Modules and Imports
package my_package;
import std::io;
import std::collections::HashMap;

# Traits and Interfaces
trait Printable {
    fn print(self);
}

# Structures
struct User {
    name: String,
    age: u8,
    active: bool,
}

# Type Aliases
type ID = u64;

# Enums with Associated Data
enum Status {
    Active,
    Inactive,
    Pending(u32),
}

# Functions
fn calculate_sum(a: i32, b: i32) -> i32 {
    return a + b;
}

# Generics
fn identity⟨T⟩(x: T) -> T {
    x
}

# Pattern Matching
match status {
    Status::Active => println("Active"),
    Status::Inactive => println("Inactive"),
    Status::Pending(val) => println("Pending: {}", val),
}

# Control Flow
if x > 10 {
    print("Greater");
} else if x == 10 {
    print("Equal");
} else {
    print("Lesser");
}

for i in 0..10 {
    print(i);
}

while true {
    break;
}

# Lambdas / Closures
let add_one = |x| x + 1;

# Macros
@macro_call(arg1, arg2);

# Annotations / Attributes
@derive(Debug, Clone)
struct Point {
    x: f64,
    y: f64,
}

# String Literals
let s = "Hello, world!";
let raw = r"Raw string \n not escaped";
let format = f"Values: {x}, {y}";

# Numeric Literals
let hex = 0xFF;
let bin = 0b1010;
let oct = 0o777;
let float = 3.14159;
let sci = 1.23e-4;

# Operators
let result = (a + b) * c / d % e;
let logic = true && false || !true;
let bitwise = x & y | z ^ w << 1 >> 2;

# Error Handling
try {
    risky_operation();
} catch e {
    handle_error(e);
}

# Classes (if supported)
class Animal {
    new(name: String) {
        this.name = name;
    }
}

# Comments
# Single line
# Another line
